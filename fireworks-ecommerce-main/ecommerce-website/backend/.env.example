# Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=your-super-secure-jwt-secret-key-here
COOKIE_SECRET=your-cookie-secret-key

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fireworkshub
DB_TYPE=file # Options: mongodb, file

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_AI_KEY=your-google-ai-api-key-here

# AI Features Toggle
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_FRAUD_DETECTION=true
ENABLE_PRICE_OPTIMIZATION=true
ENABLE_INVENTORY_AI=true
ENABLE_CUSTOMER_ANALYTICS=true

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_NAME=FireworksHub
FROM_EMAIL=noreply@fireworkshub.com

# Payment Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# File Upload Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_RATE_LIMITING=false

# AI Analytics Configuration
AI_PREDICTION_CONFIDENCE_THRESHOLD=75
AI_ANOMALY_DETECTION_SENSITIVITY=2.5
AI_RECOMMENDATION_COUNT=8
AI_FORECAST_PERIOD=6