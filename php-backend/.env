# SK Bakers E-Commerce - PHP Backend Configuration
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME="SK Bakers E-Commerce"
APP_ENV=production
APP_VERSION=2.0.0
APP_DEBUG=false

# Database Configuration
# Local development settings (using existing database)
DB_HOST=localhost
DB_NAME=u707629033_skbakers_main
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

# JWT Authentication
JWT_SECRET=your-very-secure-random-string-change-this-in-production
JWT_EXPIRY=604800
# 604800 seconds = 7 days

# CORS Configuration
# Add your React frontend URL here (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,https://skbakers.com,https://www.skbakers.com

# Base URL
# Your API base URL (e.g., https://yourdomain.com/api or https://api.yourdomain.com)
BASE_URL=https://skbakers.com/api

# File Upload Settings
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=5242880
# 5242880 bytes = 5MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp

# Email Configuration (for order notifications and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@skbakers.com
SMTP_FROM_NAME="SK Bakers"

# Payment Gateway Configuration (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Security Settings
COOKIE_SECRET=your-cookie-secret-key
SESSION_TIMEOUT=3600
# 3600 seconds = 1 hour

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60
# 100 requests per 60 seconds

# Logging
LOG_ENABLED=true
LOG_FILE=logs/activity.log
LOG_LEVEL=error
# Options: debug, info, warning, error

# Frontend URL (for email links and redirects)
FRONTEND_URL=https://skbakers.com
